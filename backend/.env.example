# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# User behavior: số ngày giữ event thô (job prune). Tối thiểu 7, mặc định trong code = 90 nếu không set.
USER_BEHAVIOR_RETENTION_DAYS=90

# Rollup daily: ngày UTC dạng YYYY-MM-DD (tuỳ chọn). Không set = hôm qua UTC.
# USER_BEHAVIOR_ROLLUP_DAY=2025-03-28

# JWT / app
# Bắt buộc. Sinh secret riêng, KHÔNG dùng lại giá trị mẫu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=7d

# Giới hạn tần suất request (chống dò mật khẩu và chống đốt quota Gemini).
# Đặt RATE_LIMIT_ENABLED=false để tắt khi cần chạy kiểm thử tải.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=5000
RATE_LIMIT_AUTH_MAX=300
RATE_LIMIT_AI_MAX=60
FRONTEND_URL=http://localhost:5173
DAILY_JOBS_ENABLED=true
DAILY_JOBS_RUN_ON_START=true
DAILY_JOBS_INTERVAL_HOURS=24

# Idempotent tasks started in the background when the backend starts.
AUTO_SETUP_SIMILARITY=true
AUTO_EMBED_PRODUCTS=true

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chat: compare, assistant, review moderation, image search
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# Embeddings for product search / RAG
GEMINI_EMBED_MODEL=gemini-embedding-001
# Upload-image detect (vision) — must be a Gemini multimodal model, not Gemma
IMAGE_SEARCH_MODEL=gemini-3.1-flash-lite
# Optional fallback if primary is rate-limited (e.g. gemini-2.5-flash)
IMAGE_SEARCH_FALLBACK_MODEL=
# Store currency (USD) — shipping & free-ship threshold in seed/settings
SHIPPING_FEE=9.99
FREE_SHIPPING_THRESHOLD=199
# VN payment gateways (MoMo/VNPay) convert USD checkout total → VND
USD_TO_VND_RATE=25000
# MoMo sandbox minimum charge (VND)
MOMO_MIN_AMOUNT_VND=1000

# Optional HTTP proxy for Google API (some networks)
# AI_HTTP_PROXY=

# ---------------------------------------------------------------------------
# Bo sung: cac bien env con lai backend dung
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development
# URL public cua backend / frontend (link thanh toan, email, webhook)
BACKEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
STORE_NAME=NGX Store
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
PLATFORM_COMMISSION_RATE=0.05

# --- Job nen ---
# 0 = API khong chay scheduler, chay `npm run worker` (docker compose da lam san)
JOBS_IN_API=1
# Tat tung job: dat 0
JOB_EXPIRE_UNPAID_ORDERS_ENABLED=1
JOB_SYNC_SHIPMENTS_ENABLED=1
JOB_FRAUD_REVIEW_SCAN_ENABLED=1
RECOMMENDATION_LOG_RETENTION_DAYS=30

# --- Van chuyen ---
# Bi mat xac thuc webhook van chuyen. BAT BUOC doi o production.
SHIPPING_WEBHOOK_SECRET=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_API_BASE=
GHTK_TOKEN=
GHTK_API_BASE=

# --- SMS OTP xac thuc so dien thoai ---
# mock = chi log ra console (dev). Production can nha cung cap that.
SMS_PROVIDER=mock

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Cloudinary (upload anh) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- MoMo (sandbox) ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_IPN_URL=
MOMO_REDIRECT_URL=

# --- VNPay (sandbox) ---
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_HASH_ALG=SHA512
VNP_HOST=
VNP_RETURN_URL=
VNP_TEST_MODE=true

# --- Chuyen khoan QR (VietQR) ---
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
QR_TEMPLATE=compact2

# --- Loyalty ---
LOYALTY_UNIT_AMOUNT=10
LOYALTY_POINTS_PER_UNIT=1
LOYALTY_MIN_REDEEM_POINTS=100
LOYALTY_REDEEM_POINTS_PER_DOLLAR=100

# --- AI tinh chinh (de trong = mac dinh trong code) ---
GEMINI_BASE_URL=
AI_MAX_HISTORY=
AI_RETRIEVE_K=
AI_RETRIEVAL_CACHE_TTL_MS=
AI_RETRIEVAL_LEXICAL_GATE=
AI_LLM_TOPIC_CLASSIFIER=
IMAGE_SEARCH_ENABLED=true
IMAGE_SEARCH_MAX_FILE_MB=
IMAGE_SEARCH_RETRY_COUNT=
IMAGE_SEARCH_TIMEOUT_MS=
REVIEW_MODERATION_ENABLED=true
REVIEW_MODERATION_MODEL=
REVIEW_MODERATION_TIMEOUT_MS=

# --- Metrics / canh bao ---
METRICS_5XX_ALERT=
METRICS_P95_ALERT_MS=
METRICS_NOTIFY_THROTTLE_MS=

# --- Script danh gia / test tai (khong dung luc chay server) ---
# EVAL_RPM=
# LOAD_CONCURRENCY=
# LOAD_ROUNDS=
# LOAD_WARMUP=
# API_URL=http://localhost:3000
# DEMO_CHECK_AI=0
