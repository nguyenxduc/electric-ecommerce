{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "API sàn thương mại điện tử đa gian hàng tích hợp AI (Express + Prisma + PostgreSQL/pgvector)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/index.js",
    "seed:full": "node seed/index.js && node scripts/embed-products.js",
    "embed:products": "node scripts/embed-products.js",
    "embed:products:force": "node scripts/embed-products.js --force",
    "eval:ai": "node scripts/evaluate-ai.js",
    "docs:erd": "node scripts/generate-erd.js",
    "startup:tasks": "node scripts/run-startup-tasks.js",
    "setup:similarity": "node scripts/setup_similarity.js",
    "job:cf-similarity": "node jobs/computeProductSimilarity.js",
    "job:offline-user-recommendation": "node jobs/computeUserRecommendations.js",
    "job:prune-user-behavior": "node jobs/pruneUserBehavior.js",
    "job:prune-recommendation-log": "node jobs/pruneRecommendationLog.js",
    "job:rollup-user-behavior-daily": "node jobs/rollupUserBehaviorDaily.js",
    "job:daily-recommendation": "node jobs/runDailyRecommendationJobs.js",
    "test": "npm run seed && node --test --test-concurrency=1 \"tests/[0-9][0-9]-*.test.mjs\"",
    "test:demo": "node --test \"tests/demo-readiness.test.mjs\"",
    "eval:rag": "node scripts/evaluate-rag.js"
  },
  "dependencies": {
    "@langchain/core": "^0.3.79",
    "@langchain/google-genai": "^0.2.18",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.7.4",
    "undici": "^8.1.0",
    "vnpay": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^6.19.0"
  },
  "keywords": [
    "ecommerce",
    "marketplace",
    "api",
    "nodejs",
    "express",
    "prisma",
    "postgresql",
    "pgvector",
    "ai",
    "rag"
  ],
  "author": "nguyencongduc",
  "license": "MIT"
}
