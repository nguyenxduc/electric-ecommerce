generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ArInternalMetadata {
  key        String   @id
  value      String?
  created_at DateTime
  updated_at DateTime

  @@map("ar_internal_metadata")
}

model SchemaMigration {
  version String @id

  @@map("schema_migrations")
}

model Category {
  id          BigInt    @id @default(autoincrement())
  name        String?
  slug        String?   @unique
  image_url   String?
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // relations
  sub_categories SubCategory[]
  products       Product[]
  filter_options FilterOption[]

  @@map("categories")
}

model SubCategory {
  id          BigInt    @id @default(autoincrement())
  name        String?
  image_url   String?
  description String?
  category_id BigInt
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // relations
  category Category  @relation(fields: [category_id], references: [id])
  products Product[]

  @@map("sub_categories")
}

model Product {
  id              BigInt                   @id @default(autoincrement())
  name            String
  price           Decimal                  @db.Decimal(10, 2)
  discount        Decimal                  @default(0.0) @db.Decimal(10, 2)
  quantity        Int                      @default(0) // total stock (optional aggregate)
  sold            Int                      @default(0)
  img             String[]                 @db.Text
  specs           Json                     @default("[]")
  specs_detail    Json                     @default("[]")
  color           Json                     @default("[]") // legacy color list
  product_colors  ProductColor[]
  shop_id         BigInt
  category_id     BigInt
  sub_category_id BigInt?
  rating          Decimal?                 @db.Decimal(3, 2)
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt
  deleted_at      DateTime?
  description     String?
  // Khoi luong mot don vi, dung de bao gia van chuyen theo can nang.
  weight_grams    Int                      @default(500)
  // Cột full-text do trigger trong DB tự cập nhật, Prisma không ghi vào cột này.
  // Xem prisma/migrations/20260909_product_search_vector.
  search_vector   Unsupported("tsvector")?
  // relations
  shop            Shop                     @relation(fields: [shop_id], references: [id])
  category        Category                 @relation(fields: [category_id], references: [id])
  sub_category    SubCategory?             @relation(fields: [sub_category_id], references: [id])
  reviews         Review[]
  order_items     OrderItem[]
  cart_items      CartItem[]
  wishlists       Wishlist[]
  embedding       ProductEmbedding?        @relation("ProductEmbedding")
  filter_values   ProductFilterValue[]
  variants        ProductVariant[]

  @@index([name])
  @@index([shop_id])
  @@index([category_id])
  @@index([sub_category_id])
  @@index([price])
  @@index([rating])
  @@map("products")
}

// A seller's storefront within the marketplace. One shop per user.
model Shop {
  id               BigInt  @id @default(autoincrement())
  owner_id         BigInt  @unique
  name             String
  slug             String  @unique
  description      String?
  logo_url         String?
  banner_url       String?
  status           String  @default("pending") // pending | active | rejected | suspended
  rejection_reason String?
  contact_email    String?
  contact_phone    String?
  address          String?

  // Per-shop shipping overrides. Read by cart.controller.js and
  // order.controller.js; null falls back to the platform-wide Setting.
  shipping_fee_override            Decimal? @db.Decimal(10, 2)
  free_shipping_threshold_override Decimal? @db.Decimal(10, 2)

  // Dia chi lay hang cho don vi van chuyen.
  pickup_province String?
  pickup_district String?
  pickup_ward     String?
  pickup_address  String?

  // Thue: household = ho kinh doanh/ca nhan, san khau tru thue thay
  // (ND 117/2025); company = doanh nghiep tu ke khai, khong khau tru.
  tax_code        String?
  tax_entity_type String  @default("household")

  approved_at DateTime?
  approved_by BigInt?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // relations
  owner            User             @relation("ShopOwner", fields: [owner_id], references: [id])
  products         Product[]
  orders           Order[]
  coupons          Coupon[]
  chats            Chat[]
  return_requests  ReturnRequest[]
  invoices         Invoice[]
  tax_withholdings TaxWithholding[]

  @@index([status])
  @@index([slug])
  @@map("shops")
}

model ProductEmbedding {
  product_id BigInt                @id
  content    String?
  embedding  Unsupported("vector")
  updated_at DateTime              @default(now())

  product Product @relation("ProductEmbedding", fields: [product_id], references: [id])

  @@map("product_embeddings")
}

// Per-color inventory for a product
model ProductColor {
  id         BigInt    @id @default(autoincrement())
  product_id BigInt
  name       String?
  code       String?
  quantity   Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  product Product @relation(fields: [product_id], references: [id])

  @@unique([product_id, code])
  @@map("product_colors")
}

// Bien the ban duoc (SKU): mot to hop thuoc tinh (mau, dung luong...) co ton
// kho va chenh lech gia rieng. San pham co bien the thi mua phai chon bien the;
// san pham khong co bien the van di luong mau/ton tong cu.
model ProductVariant {
  id          BigInt    @id @default(autoincrement())
  product_id  BigInt
  sku         String    @unique
  name        String
  attributes  Json      @default("{}")
  price_delta Decimal   @default(0.0) @db.Decimal(10, 2)
  quantity    Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  product     Product     @relation(fields: [product_id], references: [id])
  cart_items  CartItem[]
  order_items OrderItem[]

  @@index([product_id])
  @@map("product_variants")
}

model ProductSpec {
  id         BigInt    @id @default(autoincrement())
  label      String?
  value      Json?     @default("[]")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("product_specs")
}

model User {
  id                      BigInt    @id @default(autoincrement())
  name                    String?
  email                   String?   @unique
  password_digest         String?
  email_verified          Boolean   @default(false)
  verification_code       String?
  verification_expires_at DateTime?
  reset_code              String?
  reset_expires_at        DateTime?
  role                    String?   @default("user")
  phone                   String?
  // Dat khi xac thuc OTP; mot so da xac thuc chi thuoc mot tai khoan.
  phone_verified_at       DateTime?
  address                 String?
  avatar                  String?
  // Loyalty & segmentation
  loyalty_points          Int       @default(0)
  segment                 String? // e.g. BRONZE, SILVER, GOLD, PLATINUM
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  // relations
  orders          Order[]
  order_groups    OrderGroup[]
  reviews         Review[]
  carts           Cart[]
  wishlists       Wishlist[]
  coupons         Coupon[]        @relation("UserCoupons")
  chats           Chat[]
  messages        Message[]       @relation("MessageSender")
  ai_chats        AiChat[]
  shop            Shop?           @relation("ShopOwner")
  return_requests ReturnRequest[]

  @@map("users")
}

model LoyaltyPointTransaction {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt
  order_id    BigInt? // nếu điểm đến từ đơn hàng
  points      Int // dương = cộng điểm, âm = trừ điểm
  type        String // EARN | REDEEM | ADJUST
  description String?
  created_at  DateTime @default(now())

  @@index([user_id, created_at])
  @@index([order_id])
  @@map("loyalty_point_transactions")
}

model Cart {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // relations
  user       User       @relation(fields: [user_id], references: [id])
  cart_items CartItem[]

  @@map("carts")
}

model CartItem {
  id         BigInt    @id @default(autoincrement())
  cart_id    BigInt
  product_id BigInt
  quantity   Int       @default(1)
  color      Json
  variant_id BigInt?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // relations
  cart    Cart            @relation(fields: [cart_id], references: [id])
  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@map("cart_items")
}

// One buyer checkout. Splits into one Order per shop (order_group.orders),
// but carries the checkout-level totals/shipping/payment info that don't
// belong to any single shop.
model OrderGroup {
  id               BigInt    @id @default(autoincrement())
  user_id          BigInt
  group_number     String    @unique
  subtotal_amount  Decimal   @db.Decimal(10, 2)
  tier_discount    Decimal   @default(0.0) @db.Decimal(10, 2)
  coupon_discount  Decimal   @default(0.0) @db.Decimal(10, 2)
  shipping_fee     Decimal   @default(0.0) @db.Decimal(10, 2)
  total_amount     Decimal   @db.Decimal(10, 2)
  coupon_id        BigInt?
  payment_method   String?
  shipping_address Json?
  receiver_name    String?
  receiver_phone   String?
  // Yeu cau xuat hoa don cong ty: { company_name, tax_code, address, email }
  invoice_request  Json?
  // Dau vet chong gian lan (khong phai dinh danh tuyet doi, chi de doi chieu).
  client_ip        String?
  device_id        String?
  risk_score       Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  // relations
  user     User      @relation(fields: [user_id], references: [id])
  coupon   Coupon?   @relation(fields: [coupon_id], references: [id])
  orders   Order[]
  payments Payment[]

  @@index([user_id, created_at])
  @@map("order_groups")
}

// One shop's share of a buyer's checkout. Independently tracked status per
// shop so sellers can fulfill without depending on each other.
model Order {
  id               BigInt    @id @default(autoincrement())
  user_id          BigInt
  shop_id          BigInt
  order_group_id   BigInt
  order_number     String?   @unique
  total_amount     Decimal?  @db.Decimal(10, 2)
  shipping_fee     Decimal   @default(0.0) @db.Decimal(10, 2)
  status           String?   @default("pending")
  shipping_address Json?
  receiver_name    String?
  receiver_phone   String?
  payment_method   String?
  coupon_id        BigInt?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  // relations
  user            User            @relation(fields: [user_id], references: [id])
  shop            Shop            @relation(fields: [shop_id], references: [id])
  order_group     OrderGroup      @relation(fields: [order_group_id], references: [id])
  order_items     OrderItem[]
  coupon          Coupon?         @relation(fields: [coupon_id], references: [id])
  return_request  ReturnRequest?
  shipment        Shipment?
  invoice         Invoice?
  tax_withholding TaxWithholding?

  @@index([shop_id])
  @@index([status, created_at])
  @@index([order_group_id])
  @@map("orders")
}

// Buyer-initiated return/refund request for a delivered shop-order.
// One request per order; seller (or admin) approves/rejects.
model ReturnRequest {
  id              BigInt   @id @default(autoincrement())
  order_id        BigInt   @unique
  user_id         BigInt
  shop_id         BigInt
  reason          String
  status          String   @default("pending") // pending | approved | rejected
  resolution_note String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // relations
  order Order @relation(fields: [order_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])
  shop  Shop  @relation(fields: [shop_id], references: [id])

  @@index([shop_id, status])
  @@index([user_id])
  @@map("return_requests")
}

// Thông báo hệ thống gửi cho người dùng
model Notification {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt? // null = broadcast
  title      String
  message    String
  type       String? // ORDER, PROMO, SYSTEM...
  is_read    Boolean   @default(false)
  created_at DateTime  @default(now())
  read_at    DateTime?

  @@index([user_id, created_at])
  @@index([is_read, created_at])
  @@map("notifications")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt?
  action      String // ví dụ: LOGIN, ORDER_STATUS_UPDATE, PRODUCT_CREATE...
  resource    String? // e.g. "order", "product", "user"
  resource_id BigInt?
  ip          String?
  user_agent  String?
  metadata    Json?    @default("{}")
  created_at  DateTime @default(now())

  @@index([user_id, created_at])
  @@index([resource, resource_id])
  @@index([action, created_at])
  @@map("audit_logs")
}

model OrderItem {
  id          BigInt    @id @default(autoincrement())
  order_id    BigInt
  product_id  BigInt
  quantity    Int?      @default(1)
  unit_price  Decimal?  @db.Decimal(10, 2)
  total_price Decimal?  @db.Decimal(10, 2)
  color       String?
  variant_id  BigInt?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // relations
  order   Order           @relation(fields: [order_id], references: [id])
  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@map("order_items")
}

model Review {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  product_id BigInt
  rating     Int?
  comment    String?
  client_ip  String?
  device_id  String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // relations
  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("reviews")
}

model Wishlist {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  product_id BigInt
  created_at DateTime  @default(now())
  deleted_at DateTime?

  // relations
  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id])
  @@map("wishlists")
}

model Coupon {
  id             BigInt    @id @default(autoincrement())
  code           String    @unique
  description    String?
  discount_type  String    @default("percent")
  discount_value Decimal   @db.Decimal(10, 2)
  min_order      Decimal?  @db.Decimal(10, 2)
  usage_limit    Int?      @default(1)
  used_count     Int?      @default(0)
  // null = platform-wide voucher; set = only applies to that shop's items
  shop_id        BigInt?
  expires_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  // relations
  shop         Shop?        @relation(fields: [shop_id], references: [id])
  orders       Order[]
  order_groups OrderGroup[]
  users        User[]       @relation("UserCoupons")

  @@index([shop_id])
  @@map("coupons")
}

model FilterKey {
  id          BigInt    @id @default(autoincrement())
  key         String    @unique // 'brand', 'ram', 'screen_size', etc.
  label       String // Display name: 'Brand', 'RAM', etc.
  description String? // Optional description
  data_type   String    @default("string") // string, number, boolean, range
  is_active   Boolean   @default(true)
  order       Int       @default(0) // Display order
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // relations
  filter_options        FilterOption[]
  product_filter_values ProductFilterValue[]

  @@index([key])
  @@map("filter_keys")
}

model FilterOption {
  id            BigInt    @id @default(autoincrement())
  filter_key_id BigInt // Reference to FilterKey
  value         String // Legacy field for backward compatibility
  display_value String? // Value shown to user: '30% or more', 'On Sale'
  query_value   String? // Value used for querying: '>=30', 'discount>0'
  category_id   BigInt? // Optional: filter by category
  order         Int       @default(0) // Display order
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  // relations
  filter_key            FilterKey            @relation(fields: [filter_key_id], references: [id])
  category              Category?            @relation(fields: [category_id], references: [id])
  product_filter_values ProductFilterValue[]

  // Postgres treats every NULL as distinct, so this alone doesn't dedupe
  // global options (category_id IS NULL). A partial unique index closes that
  // gap - see migrations/20260905_filter_options_global_unique (can't be
  // expressed here since @@unique has no WHERE clause in the schema DSL).
  @@unique([filter_key_id, value, category_id])
  @@index([filter_key_id, category_id])
  @@map("filter_options")
}

model Payment {
  id              BigInt    @id @default(autoincrement())
  order_group_id  BigInt
  provider        String    @default("momo")
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("VND")
  status          String    @default("pending") // pending, paid, failed, expired, canceled
  momo_order_id   String? // orderId returned by MoMo
  momo_request_id String?   @unique // requestId used when creating payment
  momo_trans_id   String? // transId returned after payment
  pay_url         String?
  deeplink        String?
  qr_code_url     String?
  signature       String?
  extra_data      String?
  result_code     Int?
  message         String?
  paid_at         DateTime?
  expired_at      DateTime?
  raw_response    Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  // relations
  order_group OrderGroup @relation(fields: [order_group_id], references: [id])

  @@index([order_group_id])
  @@map("payments")
}

// Platform-wide settings (bank account, store identity, shipping defaults).
// Shop-specific settings live on the Shop model, not here.
model Setting {
  id          BigInt    @id @default(autoincrement())
  key         String    @unique // e.g., 'bank_account_no', 'bank_account_name', 'shipping_fee', etc.
  value       String // Value stored as string (can be JSON string for complex data)
  description String? // Human-readable description
  category    String    @default("general") // bank, shipping, general, payment, etc.
  data_type   String    @default("string") // string, number, boolean, json
  is_public   Boolean   @default(false) // Whether this setting can be accessed without auth
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  @@index([category])
  @@index([key])
  @@map("settings")
}

model Chat {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt // Customer who initiated the chat
  // null = support chat with the platform admin; set = chat with that shop
  shop_id    BigInt?
  status     String    @default("open") // open, closed, resolved
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // relations
  user     User      @relation(fields: [user_id], references: [id])
  shop     Shop?     @relation(fields: [shop_id], references: [id])
  messages Message[]

  @@index([user_id])
  @@index([shop_id])
  @@index([status])
  @@map("chats")
}

model Message {
  id         BigInt    @id @default(autoincrement())
  chat_id    BigInt
  sender_id  BigInt // User ID (can be customer or admin)
  content    String
  is_read    Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // relations
  chat   Chat @relation(fields: [chat_id], references: [id])
  sender User @relation("MessageSender", fields: [sender_id], references: [id])

  @@index([chat_id])
  @@index([sender_id])
  @@index([is_read])
  @@map("messages")
}

model AiChat {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  title      String?
  thread_key String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User        @relation(fields: [user_id], references: [id])
  messages AiMessage[]

  @@index([user_id])
  @@index([updated_at])
  @@map("ai_chats")
}

model AiMessage {
  id         BigInt   @id @default(autoincrement())
  ai_chat_id BigInt
  role       String
  content    String
  metadata   Json?    @default("{}")
  created_at DateTime @default(now())

  ai_chat AiChat @relation(fields: [ai_chat_id], references: [id], onDelete: Cascade)

  @@index([ai_chat_id])
  @@index([created_at])
  @@map("ai_messages")
}

model AiFeedback {
  id            BigInt   @id @default(autoincrement())
  ai_message_id BigInt
  user_id       BigInt
  rating        Int // 1-5
  comment       String?
  created_at    DateTime @default(now())

  @@index([ai_message_id])
  @@index([user_id])
  @@map("ai_feedback")
}

// Lightweight event log for recommendation & analytics.
// Lưu ý: bảng này sẽ rất lớn theo thời gian, nên dùng cho dữ liệu gần đây
// và có thể archive/aggregate định kỳ sang kho khác.
model UserBehavior {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  session_id String? // cho user chưa đăng nhập
  product_id BigInt?
  event_type String // view | click | add_to_cart | purchase ...
  event_time DateTime @default(now())
  metadata   Json?    @default("{}")

  @@index([user_id, event_time])
  @@index([product_id, event_time])
  @@index([event_type, event_time])
  @@index([event_time])
  @@map("user_behavior")
}

// Gom nhóm hành vi theo ngày (visitor + sản phẩm + loại sự kiện) — giữ lâu dài, bảng nhỏ hơn raw.
// visitor_key: "user:<id>" hoặc "sess:<session_id|unknown>"
model UserBehaviorDaily {
  id          BigInt   @id @default(autoincrement())
  visitor_key String
  product_id  BigInt   @default(0)
  event_type  String
  day         DateTime @db.Date
  event_count Int      @default(0)
  updated_at  DateTime @default(now()) @updatedAt

  @@unique([visitor_key, product_id, event_type, day])
  @@index([day])
  @@index([visitor_key, day])
  @@index([product_id, day])
  @@map("user_behavior_daily")
}

// Bảng lưu điểm tương đồng giữa các sản phẩm, được tính offline.
// Không bắt buộc quan hệ Prisma để giữ schema đơn giản, dùng id thuần tuý.
model ProductSimilarity {
  id                 BigInt   @id @default(autoincrement())
  product_id         BigInt
  similar_product_id BigInt
  score              Float
  updated_at         DateTime @default(now())

  @@unique([product_id, similar_product_id])
  @@index([product_id])
  @@map("product_similarity")
}

// Log kết quả gợi ý đã được precompute để API trả nhanh.
model RecommendationLog {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt?
  session_id  String?
  strategy    String // e.g. "personalized_cf", "cold_start_best_seller"
  product_ids BigInt[]
  created_at  DateTime @default(now())

  @@index([user_id, created_at])
  @@index([session_id, created_at])
  @@index([strategy, created_at])
  @@map("recommendation_log")
}

model ProductFilterValue {
  id            BigInt  @id @default(autoincrement())
  product_id    BigInt
  filter_key_id BigInt
  option_id     BigInt?

  raw_value  String?
  created_at DateTime @default(now())

  product    Product       @relation(fields: [product_id], references: [id])
  filter_key FilterKey     @relation(fields: [filter_key_id], references: [id])
  option     FilterOption? @relation(fields: [option_id], references: [id])

  @@unique([product_id, filter_key_id])
  @@index([product_id])
  @@index([filter_key_id])
}

// ---------------------------------------------------------------------------
// Van chuyen + COD
// ---------------------------------------------------------------------------

// Mot van don cho mot don con (mot shop). Tien te cua fee/cod_amount la VND
// vi day la so lieu cua don vi van chuyen, khong phai gia ban (USD).
model Shipment {
  id                BigInt    @id @default(autoincrement())
  order_id          BigInt    @unique
  carrier           String // mock | ghn | ghtk
  tracking_code     String?   @unique
  status            String    @default("created") // created | picking | in_transit | delivered | returned | cancelled | failed
  fee_vnd           Int       @default(0)
  cod_amount_vnd    Int       @default(0)
  weight_grams      Int       @default(0)
  label_url         String?
  raw               Json?     @default("{}")
  cod_collected_at  DateTime?
  cod_settlement_id BigInt?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  order          Order           @relation(fields: [order_id], references: [id])
  events         ShipmentEvent[]
  cod_settlement CodSettlement?  @relation(fields: [cod_settlement_id], references: [id])

  @@index([status, updated_at])
  @@index([carrier, cod_collected_at])
  @@map("shipments")
}

model ShipmentEvent {
  id          BigInt   @id @default(autoincrement())
  shipment_id BigInt
  status      String
  description String?
  occurred_at DateTime @default(now())
  raw         Json?    @default("{}")
  created_at  DateTime @default(now())

  shipment Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@index([shipment_id, occurred_at])
  @@map("shipment_events")
}

// Mot dot doi soat COD voi don vi van chuyen: tien hang ho thu duoc chuyen ve.
model CodSettlement {
  id                  BigInt   @id @default(autoincrement())
  carrier             String
  reference           String? // ma bang ke cua don vi van chuyen
  expected_amount_vnd Int
  received_amount_vnd Int
  difference_vnd      Int
  note                String?
  created_by          BigInt?
  created_at          DateTime @default(now())

  shipments Shipment[]

  @@index([carrier, created_at])
  @@map("cod_settlements")
}

// ---------------------------------------------------------------------------
// Chong gian lan
// ---------------------------------------------------------------------------

model OtpCode {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  phone       String
  purpose     String    @default("verify_phone")
  code_hash   String
  attempts    Int       @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([phone, created_at])
  @@index([user_id, created_at])
  @@map("otp_codes")
}

model FraudFlag {
  id          BigInt    @id @default(autoincrement())
  type        String // COUPON_ABUSE | ORDER_RISK | SELF_DEALING | REVIEW_SUSPECT
  subject     String // order_group | review | user
  subject_id  BigInt
  user_id     BigInt?
  score       Int       @default(0)
  reasons     Json      @default("[]")
  status      String    @default("open") // open | confirmed | dismissed
  resolved_by BigInt?
  resolved_at DateTime?
  created_at  DateTime  @default(now())

  @@unique([type, subject, subject_id])
  @@index([status, created_at])
  @@index([user_id])
  @@map("fraud_flags")
}

// ---------------------------------------------------------------------------
// Hoa don + thue
// ---------------------------------------------------------------------------

model Invoice {
  id             BigInt    @id @default(autoincrement())
  order_id       BigInt    @unique
  shop_id        BigInt
  invoice_number String    @unique
  series         String
  provider       String    @default("internal")
  provider_ref   String?
  seller         Json // snapshot: name, tax_code, address
  buyer          Json // snapshot: name, phone, address, company_name?, tax_code?, email?
  items          Json // snapshot cac dong hang
  subtotal       Decimal   @db.Decimal(12, 2) // chua VAT
  vat_rate       Decimal   @db.Decimal(5, 4)
  vat_amount     Decimal   @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2) // da gom VAT
  currency       String    @default("USD")
  status         String    @default("issued") // issued | cancelled
  issued_at      DateTime  @default(now())
  cancelled_at   DateTime?
  created_at     DateTime  @default(now())

  order Order @relation(fields: [order_id], references: [id])
  shop  Shop  @relation(fields: [shop_id], references: [id])

  @@index([shop_id, issued_at])
  @@map("invoices")
}

// Thue san khau tru thay ho kinh doanh tren tung don giao thanh cong.
model TaxWithholding {
  id          BigInt    @id @default(autoincrement())
  order_id    BigInt    @unique
  shop_id     BigInt
  period      String // YYYY-MM
  base_amount Decimal   @db.Decimal(12, 2)
  vat_rate    Decimal   @db.Decimal(5, 4)
  vat_amount  Decimal   @db.Decimal(12, 2)
  pit_rate    Decimal   @db.Decimal(5, 4)
  pit_amount  Decimal   @db.Decimal(12, 2)
  reversed_at DateTime?
  created_at  DateTime  @default(now())

  order Order @relation(fields: [order_id], references: [id])
  shop  Shop  @relation(fields: [shop_id], references: [id])

  @@index([shop_id, period])
  @@index([period])
  @@map("tax_withholdings")
}
